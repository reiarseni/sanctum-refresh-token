{
    "name": "reiarseni/sanctum-refresh-token",
    "description": "Refresh tokens for Laravel Sanctum with token families, rotation and reuse detection.",
    "keywords": [
        "laravel",
        "sanctum",
        "refresh-token",
        "token-rotation",
        "reuse-detection",
        "authentication"
    ],
    "homepage": "https://github.com/reiarseni/sanctum-refresh-token",
    "license": "MIT",
    "authors": [
        {
            "name": "Reinaldo Arsenio Lorenzo Trujillo",
            "email": "reiarseni@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/reiarseni/sanctum-refresh-token/issues",
        "source": "https://github.com/reiarseni/sanctum-refresh-token",
        "security": "https://github.com/reiarseni/sanctum-refresh-token/security/policy"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "laravel/sanctum": "^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.5|^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.3|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Reiarseni\\SanctumRefreshToken\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Reiarseni\\SanctumRefreshToken\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Reiarseni\\SanctumRefreshToken\\SanctumRefreshTokenServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
